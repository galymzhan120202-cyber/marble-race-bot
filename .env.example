# Maze Race Bot - Configuration
# Ескерту: бұл тек шаблон, нақты кілттерді осында жазбаңыз, жаңа .env файлына көшіріңіз.
# .env файлы .gitignore-де, GitHub-ке ешқашан кірмейді.

# Telegram хабарландырулары (опционал, бос қалдыруға болады)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Күніне 3 рет жүктеу уақыты (UTC, шаманы KZ-ден -5 сағат)
POST_TIMES=05:15,11:15,17:15

# Жұмыс каталогы (әдетте өзгертпеу керек)
BASE_DIR=.

# Жарыс ұзақтығы (секунд): мин/макс. Жеңімпаз финишке жетпесе, макс уақытта
# ең алға шыққан жарысшы (finish-қа қашықтығы ең аз) жеңімпаз деп жарияланады.
RACE_MIN_SECONDS=13
RACE_MAX_SECONDS=28

# Дыбыс деңгейлері (0.0 - 1.0)
MUSIC_VOLUME=0.15
SFX_VOLUME=0.9

# YouTube жүктеу параметрлері (20 = Gaming)
YOUTUBE_CATEGORY_ID=20
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false

# Видео кодтеу параметрлері
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_FPS=60
VIDEO_PRESET=ultrafast
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Қайтара сынау параметрлері
MAX_RETRIES=3
RETRY_DELAY=2

# --- Tournament (ұзын форматты, 16 жарысшы, single-elimination bracket) ---
# Shorts-тан мүлдем бөлек, cron/scheduler-де өз алдына жұмыс істейді (SETUP.md 9-бөлімін қараңыз).
TOURNAMENT_POST_TIME=08:15
TOURNAMENT_VIDEO_WIDTH=1920
TOURNAMENT_VIDEO_HEIGHT=1080
TOURNAMENT_VIDEO_FPS=30
TOURNAMENT_HEAT_ROWS=32
TOURNAMENT_HEAT_MIN_SECONDS=18
TOURNAMENT_HEAT_MAX_SECONDS=55
