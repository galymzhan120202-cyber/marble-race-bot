# Maze Race Bot - Configuration
# Ескерту: бұл тек шаблон, нақты кілттерді осында жазбаңыз, жаңа .env файлына көшіріңіз.
# .env файлы .gitignore-де, GitHub-ке ешқашан кірмейді.

# Telegram хабарландырулары (опционал, бос қалдыруға болады)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Күніне 3 слот: 2 Race + 1 Battle (UTC; KZ = UTC+5)
POST_TIMES=05:15,11:15,17:15
BATTLE_SLOT=2

# Marble Drop үшін жеке күнделікті слот (19:15 KZ)
DROP_POST_TIME=14:15

# Жұмыс каталогы (әдетте өзгертпеу керек)
BASE_DIR=.

# Жарыстың шекті уақыты (секунд). MIN параметрлері ескі баптаулармен
# үйлесімділік үшін сақталған; финишке жеткен соң жарысты жасанды созбайды.
# Таймаут болған жариялау әрекеті сапа сүзгісінен өтпей, басқа seed-пен қайталанады.
RACE_MIN_SECONDS=13
RACE_MAX_SECONDS=28

# Battle және Marble Drop жарыстарының ұзақтығы (секунд)
BATTLE_MIN_SECONDS=14
BATTLE_MAX_SECONDS=32
DROP_MIN_SECONDS=8
DROP_MAX_SECONDS=22

# Дыбыс деңгейлері (0.0 - 1.0)
MUSIC_VOLUME=0.15
SFX_VOLUME=0.9

# YouTube жүктеу параметрлері (20 = Gaming)
YOUTUBE_CATEGORY_ID=20
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false

# Видео кодтеу параметрлері
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_FPS=60
VIDEO_PRESET=ultrafast
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
BATTLE_VIDEO_WIDTH=1080
BATTLE_VIDEO_HEIGHT=1920
BATTLE_VIDEO_FPS=60
DROP_VIDEO_WIDTH=1080
DROP_VIDEO_HEIGHT=1920
DROP_VIDEO_FPS=60

# Қайтара сынау параметрлері
MAX_RETRIES=3
RETRY_DELAY=2

# Соңғы жүктелген видеолардағы қатысушылар құрамын қайталамау
AVOID_REPEAT_LOOKBACK=12
AVOID_REPEAT_MAX_ATTEMPTS=6

# Сипаттамадағы ойын және қолдау сілтемелері (опционал)
MBALL_GAME_URL=
MBALL_FUND_URL=

# --- Tournament (ұзын форматты, 16 жарысшы, single-elimination bracket) ---
# Shorts-тан бөлек, әр 4 күн сайын 06:15 UTC / 11:15 KZ (SETUP.md 6-бөлімі).
TOURNAMENT_POST_TIME=06:15
TOURNAMENT_VIDEO_WIDTH=1920
TOURNAMENT_VIDEO_HEIGHT=1080
TOURNAMENT_VIDEO_FPS=30
TOURNAMENT_HEAT_ROWS=32
TOURNAMENT_HEAT_MIN_SECONDS=18
TOURNAMENT_HEAT_MAX_SECONDS=55
